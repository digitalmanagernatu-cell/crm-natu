# ── Origen de datos ─────────────────────────────────────────────
# "excel" = Excel de SharePoint vía Microsoft Graph · "local" = data/local-db.json (demo)
DATA_SOURCE=local
# Enlace al Excel en SharePoint (el de "Copiar vínculo"); o bien DRIVE_ID + ITEM_ID
EXCEL_SHARE_URL=
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
EXCEL_CACHE_SECONDS=20

# ── Login con cuentas corporativas (Microsoft Entra ID) ─────────
AUTH_SECRET=                         # npx auth secret
AUTH_MICROSOFT_ENTRA_ID_ID=          # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=      # Client secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=   # Directory (tenant) ID
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Emails que entran como admin aunque no estén en la hoja Usuarios (para el primer arranque)
BOOTSTRAP_ADMIN_EMAILS=
# Solo desarrollo: login sin contraseña eligiendo un usuario de la hoja Usuarios
AUTH_DEV_LOGIN=false

# ── Asistente IA ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
