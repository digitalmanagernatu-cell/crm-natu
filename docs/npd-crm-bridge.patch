@@ -0,0 +1,33 @@
+import "server-only";
+
+/**
+ * Consulta de solo lectura al CRM comercial (Export / Gran Consumo) para Alexia.
+ * El CRM aplica sus propios permisos según el email de la persona: cada uno ve en el CRM
+ * exactamente lo mismo que vería entrando en él. La clave es de servidor a servidor.
+ */
+const url = () => (process.env.CRM_BRIDGE_URL || "").replace(/\/$/, "");
+const secret = () => process.env.CRM_BRIDGE_SECRET || "";
+
+export const crmEnabled = () => !!(url() && secret());
+
+export type CrmTool = "buscar_clientes" | "ver_cliente" | "resumen_pipeline" | "ver_agenda";
+
+export async function consultarCrm(email: string, herramienta: CrmTool, input: Record<string, unknown>): Promise<string> {
+  if (!crmEnabled()) return "La conexión con el CRM no está configurada.";
+  try {
+    const res = await fetch(`${url()}/api/bridge`, {
+      method: "POST",
+      headers: { Authorization: `Bearer ${secret()}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ email, herramienta, input: Object.fromEntries(Object.entries(input).filter(([, v]) => v !== undefined)) }),
+      signal: AbortSignal.timeout(20_000),
+      cache: "no-store",
+    });
+    if (res.status === 401) return "El CRM ha rechazado la conexión (clave CRM_BRIDGE_SECRET incorrecta).";
+    const data = (await res.json().catch(() => ({}))) as { resultado?: string; crm_url?: string; error?: string };
+    if (!res.ok || !data.resultado) return data.error ?? "No se ha podido consultar el CRM.";
+    const base = data.crm_url || url();
+    return `${data.resultado}\n\n(Datos del CRM comercial. Para enlazar una ficha usa ${base}/clientes/<id>.)`;
+  } catch {
+    return "El CRM no responde ahora mismo. Inténtalo de nuevo en unos segundos.";
+  }
+}
